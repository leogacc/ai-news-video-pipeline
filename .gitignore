# Secrets and local runtime state — never commit these.
.env
token.pickle
client_secrets.json
credentials/
*service_account*.json
*taskwise*.json

# Python
.venv/
__pycache__/
*.pyc

# Pipeline runtime (regenerable, local-only)
pipeline/cache/
pipeline/output/
pipeline/logs/
pipeline/backups/
.kokoro_cache/
.logs/

# Node & Remotion Cache
pipeline/tweetshot/node_modules/
pipeline/animations/node_modules/
pipeline/animations/.remotion_bundle_cache/
.remotion/
.gcp_tts_quota.json
pipeline/.gcp_tts_quota.json

# Scout per-run logs (state files stay: saved_items.json, state.json, clipped_finds.json)
scout/runs/

# Rendered media (videos live in the Telegram review queue, not the repo)
*.mp4
*.wav
