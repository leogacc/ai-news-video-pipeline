# Copy to .env and fill in real values. Never commit .env.
# Pixabay API key — stock b-roll search (illustrative generic-action shots only;
# never used for evidence shots).
PIXABAY_API_KEY=
# Telegram bot token + the review-queue chat id. Every finished render is pushed
# to this chat via pipeline/publish.py (telegram_send). The user reviews clips there.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
