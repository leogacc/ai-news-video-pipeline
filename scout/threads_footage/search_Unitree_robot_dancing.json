{"_meta":{"data":{"fbids":[18081915533417461,18196998316388690],"message_ids":[]},"tool_call_id":"call_01a17e6e77d47095a8f9ce36e43d1b1f"},"data":{"searchResults":{"discussion_disclaimer":null,"discussion_info":null,"edges":[{"node":{"thread":{"thread_items":[{"post":{"caption":{"text":"NVIDIA just open-sourced MotionBricks, a model that animates humans and robots in real time.\n\nIt takes a character’s latest poses plus target poses and fills in the motion between them, then chains those pieces like bricks into long animation. One model drives both a human skeleton and a Unitree G1 robot.\n\nCommercial use is allowed, code is Apache 2.0. Lifelike animation without a mocap session for every move."},"carousel_media":null,"carousel_media_count":null,"code":"DfAIJWij6kw","has_liked":false,"image_versions2":{"candidates":[{"height":240,"width":640},{"height":180,"width":480},{"height":120,"width":320},{"height":90,"width":240},{"height":240,"width":240},{"height":240,"width":240},{"height":240,"width":240},{"height":240,"width":240},{"height":240,"width":240},{"height":240,"width":240},{"height":150,"width":150}]},"like_count":36,"media_captured_at":{"user_local":"2026-10-27T07:59:20.000-07:00","user_timezone":"America/Los_Angeles","utc":"2026-10-27T14:59:20.000Z"},"media_type":2,"pk":"18196998316388690","taken_at":1793113160,"text_post_app_info":{"direct_reply_count":6,"quote_count":1,"repost_count":2,"share_info":{"can_repost":true,"is_reposted_by_viewer":false}},"user":{"full_name":"Yury Shishkin | AI-agents & Productivity","is_verified":true,"pk":null,"profile_pic_url":"https://scontent-lax3-2.cdninstagram.com/v/t51.2885-19/483056352_503461135933275_1670579715736885393_n.jpg?stp=dst-jpg_s150x150_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4zMjAuYzIifQ&_nc_ht=scontent-lax3-2.cdninstagram.com&_nc_cat=103&_nc_oc=Q6cZ2gF54E047A-rNbQH3QdU7ZDwl5G9YacDn6kNzT2-j7xmG1q7767iRX7Qfbv9JzXiIXNCnUB_LpCo6SlJeJ4aB0aC&_nc_ohc=1DKaI3eHWg4Q7kNvwGKfszM&_nc_gid=Il5xK21mv78O9wQZ9